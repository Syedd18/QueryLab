# Copy to .env and fill in real values. .env is git-ignored.

# Database connection.
# For Supabase, use the SESSION POOLER connection string (IPv4-friendly), not the
# direct db.<ref>.supabase.co host (IPv6-only). Find it in the Supabase dashboard:
# Project Settings -> Database -> Connection string -> Session pooler.
# The password must be URL-encoded: '@' -> %40, ':' -> %3A, etc.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Auth / JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Where per-question SQLite sandbox databases are stored (local, not Supabase)
SANDBOX_DB_DIR=./sandbox_dbs
